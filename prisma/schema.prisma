// Nexus Ledger data model.
// Tenant isolation (row-level security), the immutable-ledger triggers, period locks, CHECK constraints and partial indexes
// live in prisma/migrations as SQL, because Prisma's schema language cannot express them. Do not remove them.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PrismaMigration {
  id String @id
  checksum String
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  migrationName String @map("migration_name")
  logs String?
  rolledBackAt DateTime? @map("rolled_back_at") @db.Timestamptz(6)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  appliedStepsCount Int @default(0) @map("applied_steps_count")
  @@map("_prisma_migrations")
}

model Account {
  id String @id @default(dbgenerated("gen_id('acc'::text)"))
  organizationId String @map("organization_id")
  code String
  name String
  type String
  subtype String?
  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organizationRel Organization @relation("accounts_organization_id", fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankAccountsByAccountId BankAccount[] @relation("bank_accounts_account_id")
  bankRulesByAccountId BankRule[] @relation("bank_rules_account_id")
  billLinesByAccountId BillLine[] @relation("bill_lines_account_id")
  creditNoteLinesByAccountId CreditNoteLine[] @relation("credit_note_lines_account_id")
  invoiceLinesByAccountId InvoiceLine[] @relation("invoice_lines_account_id")
  itemsByCogsAccountId Item[] @relation("items_cogs_account_id")
  itemsByPurchaseAccountId Item[] @relation("items_purchase_account_id")
  itemsBySaleAccountId Item[] @relation("items_sale_account_id")
  journalLinesByAccountId JournalLine[] @relation("journal_lines_account_id")
  purchaseOrderLinesByAccountId PurchaseOrderLine[] @relation("purchase_order_lines_account_id")
  quoteLinesByAccountId QuoteLine[] @relation("quote_lines_account_id")
  recurringInvoiceLinesByAccountId RecurringInvoiceLine[] @relation("recurring_invoice_lines_account_id")
  @@unique([organizationId, code])
  @@map("accounts")
}

