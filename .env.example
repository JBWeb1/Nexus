# ---- Database (PostgreSQL) --------------------------------------------------
# Owner/admin connection: used only to create the database and run migrations.
DIRECT_URL=postgres://postgres:devpassword@localhost:5432/nexus_ledger
# The app connects as three separate roles (created by the migrations):
DATABASE_URL=postgres://nexus_app:nexus_app_dev_password@localhost:5432/nexus_ledger
AUTHN_DATABASE_URL=postgres://nexus_authn:nexus_authn_dev_password@localhost:5432/nexus_ledger
SERVICE_DATABASE_URL=postgres://nexus_service:nexus_service_dev_password@localhost:5432/nexus_ledger

# ---- Secrets (use long random values in production) -------------------------
AUTH_SECRET=dev-only-change-me
JWT_SECRET=dev-only-change-me
APP_URL=http://localhost:3000

# ---- Payments: Paystack (optional until you charge customers) ---------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
PAYSTACK_PLAN_CODE_MULTI=
PLAN_PRICE_ZAR=250
PLAN_PRICE_MULTI_ZAR=470

# ---- Email: Resend (optional) -----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Nexus Ledger <onboarding@resend.dev>

# ---- Receipts: Claude reads receipt photos (optional) ----------------------
ANTHROPIC_API_KEY=
# RECEIPT_MODEL=claude-opus-5-5

# ---- Daily jobs (payment reminders). Any long random value. ------------------
CRON_SECRET=
# Development only: write emails to this folder instead of sending them.
# MAIL_OUTBOX_DIR=.outbox

# ---- File storage: AWS S3 or Cloudflare R2 (optional; local disk is used without it) ----
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
